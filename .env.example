# ── PAYBRIDGE live execution ─────────────────────────────────────────────────
# Agent private key: funded EOA on Celo that holds USDC (or other treasury asset).
# NEVER commit this value. The provider reads it via process.env.AGENT_PRIVATE_KEY.
AGENT_PRIVATE_KEY=

# ── SPUR protocol ───────────────────────────────────────────────────────────
# ADDRESSES ONLY. No private keys ever live in this file.
# Deployer key: pass via `forge script ... --account <keystore>` or `--ledger`.

# Dedicated deterministic-verifier EOA (see README "Key ceremony").
# Must be independent of DEPLOYER and of every agent wallet.
SPUR_VERIFIER=0x0000000000000000000000000000000000000000
# Deployer address (checked on-chain against SPUR_VERIFIER, never signs here).
DEPLOYER=0x0000000000000000000000000000000000000000

# ── Network ──────────────────────────────────────────────────────────────────
CELO_NET=mainnet
# CELO_NET=sepolia

# ── Attribution (CRITICAL for hackathon) ─────────────────────────────────────
# Your assigned attributionTag from Celo Builders registration.
# Wire into EVERY transaction via @celo/attribution-tags before sending.
# Transactions sent WITHOUT this tag are NOT counted on the leaderboard.
CELO_ATTRIBUTION_TAG=0x

# ── Bot / gateway ────────────────────────────────────────────────────────────
PORT=8787
PAY_TO=0x0000000000000000000000000000000000000000
# Optional shared secret enforced on POST /telegram?secret= and POST /submit?secret=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
# State directory for the distribution leg (jobs + reputation JSON).
SPUR_DATA_DIR=./data

# ── Mainnet deployment (spur-deploy:mainnet) ────────────────────────────────
DEPLOYER_PRIVATE_KEY=
SPUR_VERIFIER_PRIVATE_KEY=
